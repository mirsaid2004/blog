# Copy to .env and fill in. See doc/setup-services.md for where each value comes from.
# Never commit .env.

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Neon (Postgres) ----------------------------------------------------------
# Pooled connection string (host contains "-pooler"), used by the app.
DATABASE_URL=
# Direct (unpooled) connection string, used by migrations.
DATABASE_URL_UNPOOLED=

# --- Content repo (GitHub App) ------------------------------------------------
# owner/name of the private content repo
GITHUB_CONTENT_REPO=mirsaid2004/blog-db
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# The .pem contents on one line, with newlines written as \n
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# smee.io channel set as the GitHub App's webhook URL in development (npm run webhook:dev)
SMEE_URL=

# --- Content source -------------------------------------------------------------
# "database" (default): the Neon index, filled by the webhook / npm run content:sync.
# "local": parse a checkout of the content repo at CONTENT_DIR (offline work).
# CONTENT_SOURCE=local
# CONTENT_DIR=../blog-db

# --- Auth (Better Auth) -------------------------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated numeric GitHub user ids that get the admin role
ADMIN_GITHUB_IDS=66273717

# --- Cloudflare R2 (media) ----------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=mdev-blog
R2_PRIVATE_BUCKET=mdev-blog-private
# Public base URL of blog-media: custom domain or the bucket's r2.dev URL
NEXT_PUBLIC_ASSETS_URL=

# --- Cron (scheduled publishing, orphan sweeper) ------------------------------
# openssl rand -base64 32; Vercel sends it as "Authorization: Bearer <secret>"
CRON_SECRET=
